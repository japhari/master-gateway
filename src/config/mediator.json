          "type": "string"
        },
        {
          "param": "apiKey",
          "displayName": "API Key",
          "description": "API key appended to every outbound request as api_key query param",
          "type": "password"
        },
        {
          "param": "timeoutMs",
          "displayName": "Request Timeout (ms)",
          "description": "Request timeout in milliseconds (default 10000)",
          "type": "number"
        },
        {
          "param": "retries",
          "displayName": "Retry Count",
          "description": "Number of retry attempts for transient failures (default 3)",
          "type": "number"
        },
        {
          "param": "cacheTtlMs",
          "displayName": "Cache TTL (ms)",
          "description": "In-memory response cache TTL in milliseconds. Set 0 to disable (default 60000)",
          "type": "number"
        }
      ]
    },
